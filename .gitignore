# dependencies
node_modules/
**/node_modules/
/.pnpm
.pnpm-store/

# Next.js
/.next/
/out/
.next

# Build outputs
/dist
/build

# Environment variables — ignore real secrets, but keep the example template
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# Explicitly allow the example file (negation rule)
!.env.example
**/.env
**/.env.local
**/.env.*.local
!**/.env.example

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS files
.DS_Store
# Dev database
.dev-db.json
*.dev-db.json
.rocketride/
